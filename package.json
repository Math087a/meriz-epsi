{
  "name": "meriz",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "1.7.3",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "test:release": "node --test scripts/release-version.checks.mjs",
    "electron:dev": "electron .",
    "electron:dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "fr.meriz.epsi",
    "productName": "Meriz EPSI Edition",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src-tauri/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Meriz EPSI Edition",
      "installerIcon": "src-tauri/icons/icon.ico",
      "uninstallerIcon": "src-tauri/icons/icon.ico",
      "uninstallDisplayName": "Meriz EPSI Edition"
    }
  },
  "dependencies": {
    "@radix-ui/react-select": "2.4.1",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.12.0",
    "@xyflow/react": "^12.11.1",
    "html-to-image": "^1.11.13",
    "laravel-echo": "^2.5.0",
    "pusher-js": "^8.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^5.0.1"
  }
}
